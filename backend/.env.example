# Скопируй в .env и подставь значения
GCP_PROJECT=pha-personal-health-assistant
# global нужен для моделей Gemini 3.x (в региональных вроде us-central1 их нет).
GCP_LOCATION=global

# Свитчер моделей: простые ответы → SIMPLE, сложные (мед-анализ) → COMPLEX.
GEMINI_MODEL_SIMPLE=gemini-2.5-flash
GEMINI_MODEL_COMPLEX=gemini-3.5-flash

# Ключ доступа к API. Оставь пустым, чтобы отключить проверку.
# Для прода задай длинную случайную строку и пришли её в заголовке X-API-Key.
API_KEY=

# Лимит трат на одного user_id (USD).
USER_BUDGET_USD=5

# Цены за токены (USD за 1M), официальный прайс Vertex AI (июнь 2026).
# global-эндпоинт: 2.5-flash $0.30/$2.50; 3.5-flash $1.50/$9.00.
PRICE_SIMPLE_IN=0.30
PRICE_SIMPLE_OUT=2.50
PRICE_COMPLEX_IN=1.50
PRICE_COMPLEX_OUT=9.00
