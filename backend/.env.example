# Скопируй в .env и подставь значения
GCP_PROJECT=pha-personal-health-assistant
# global нужен для моделей Gemini 3.x (в региональных вроде us-central1 их нет).
GCP_LOCATION=global

# Keep both paths on 1.5 Flash: newer Flash models hit photo rate limits here.
GEMINI_MODEL_SIMPLE=gemini-1.5-flash
GEMINI_MODEL_COMPLEX=gemini-1.5-flash

# Обязателен, минимум 32 символа. Пустое значение больше не отключает проверку.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY=

# Лимит трат на одного user_id (USD).
USER_BUDGET_USD=5

# Зашифрованные файлы истории пациентов (по email). В Docker: /data/patients
PATIENT_DATA_DIR=patient_data
# Обязателен. Без этого ключа backend не запустится. Не меняй его после того,
# как пациенты уже записаны, иначе старые файлы не расшифруются.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATIENT_ENCRYPTION_KEY=

# Twilio Email API (Basic Auth: API Key SID + Secret). Не коммить реальные секреты.
TWILIO_EMAIL_API_KEY_SID=
TWILIO_EMAIL_API_SECRET=
TWILIO_EMAIL_FROM=support@pha-app.net
TWILIO_EMAIL_FROM_NAME=PHA - Personal Health Assistant
OTP_DB=otp.db
OTP_TTL_SECONDS=600

# Секретный ключ RevenueCat (не публичный appl_…). Нужен, чтобы покупка Plus+
# сохранялась в аккаунте, а не только на телефоне.
# RevenueCat → Project settings → API keys → Secret.
REVENUECAT_SECRET_API_KEY=

# Цены за токены (USD за 1M), официальный прайс Vertex AI (июнь 2026).
# global-эндпоинт: 2.5-flash $0.30/$2.50; 3.5-flash $1.50/$9.00.
PRICE_SIMPLE_IN=0.30
PRICE_SIMPLE_OUT=2.50
PRICE_COMPLEX_IN=1.50
PRICE_COMPLEX_OUT=9.00
